{
  "version": 2,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "connect/index.html",
      "use": "@vercel/static"
    },
    {
      "src": "dashboard/index.html",
      "use": "@vercel/static"
    },
    {
      "src": "dashboard/realstate_dashboard_v2.html",
      "use": "@vercel/static"
    },
    {
      "src": "config.js",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/connect",
      "dest": "/connect/index.html"
    },
    {
      "src": "/connect/",
      "dest": "/connect/index.html"
    },
    {
      "src": "/dashboard/",
      "dest": "/dashboard/index.html"
    },
    {
      "src": "/dashboard",
      "dest": "/dashboard/index.html"
    },
    {
      "src": "/dashboard/v2",
      "dest": "/dashboard/realstate_dashboard_v2.html"
    },
    {
      "src": "/dashboard/v2/",
      "dest": "/dashboard/realstate_dashboard_v2.html"
    },
    {
      "src": "/realstate-dashboard-v2",
      "dest": "/dashboard/realstate_dashboard_v2.html"
    },
    {
      "src": "/api/(.*)",
      "dest": "https://api.yieldai.space/api/$1",
      "headers": {
        "Cache-Control": "s-maxage=0, no-store, must-revalidate"
      }
    },
    {
      "src": "/(index|connect/index|dashboard/index|dashboard/realstate_dashboard_v2)\\.html",
      "headers": {
        "Cache-Control": "s-maxage=0, no-store, must-revalidate"
      }
    },
    {
      "src": "/config.js",
      "headers": {
        "Cache-Control": "s-maxage=0, no-store, must-revalidate"
      }
    }
  ]
}