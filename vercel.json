{
  "version": 2,
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.yieldai.space/api/:path*"
    },
    {
      "source": "/webhook/:path*",
      "destination": "https://api.yieldai.space/webhook/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://api.yieldai.space/auth/:path*"
    }
  ]
}