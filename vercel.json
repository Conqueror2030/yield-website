{
  "version": 2,
  "outputDirectory": ".",
  "redirects": [
    {
      "source": "/dashboard",
      "destination": "/dashboard/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.yieldai.space/api/:path*"
    },
    {
      "source": "/webhook/:path*",
      "destination": "https://api.yieldai.space/webhook/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://api.yieldai.space/auth/:path*"
    }
  ]
}